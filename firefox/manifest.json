{
  "manifest_version": 2,
  "name": "Auto-Login Script Generator",
  "version": "1.0.0",
  "description": "Capture authentication data from active browser tab and generate auto-login scripts",
  "browser_specific_settings": {
    "gecko": {
      "id": "autologin-script-generator@extension",
      "strict_min_version": "109.0"
    }
  },
  "permissions": [
    "activeTab",
    "cookies",
    "scripting",
    "storage",
    "clipboardWrite",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "scripts": ["background/background.js"],
    "persistent": false
  },
  "browser_action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content/content-script.js"],
      "run_at": "document_idle"
    }
  ]
}
